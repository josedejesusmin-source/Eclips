# testigo_lugar_despues.eclmap -- el mismo suelo, ellas en otro lado.
#
# Estrella en la boca (vio por dónde saliste). Sol arriba, hacia
# el rincón ("por allí sigue"). Luna al otro lado, donde quiere
# terminar. Al hablar con las tres se vuelve al VN.
# La cuadrícula es la de testigo_lugar, letra por letra en las paredes.

modo: topdown
# Música al salir de la cueva: la misma canción, pero algo te siguió.
musica: "assets/musica/mapa_luna_despues.ogg"
velocidad: 300
tamano: 54
salida: lua
lua: "testigo_lugar_despues.lua"

jugador:
  sprite: "assets/cubo/"
  puede_atacar: false

tile < "":
  tipo: puerta
  destino: "vnscript/testigo_lugar_cueva.eclmap"
  posicion: 7, 7

mapa:
######################
#......###........S..#
#......#.............#
#.........#..........#
#.........#.......=..#
#.........#.......=..#
#.......B...B........#
#..B......#..........#
#.L...........E.P....#
#.............#.#....#
#.............#<#....#
######################

npc S "Sol" #FFAA33:
  "You came back."
  "We looked a little further."
  "The road goes on that way."
  "I don't know how far it goes."
  # (Pausa breve.)
  "I marked it on the map."
  "In case we want to go on."

npc L "Luna" #9966BB:
  "There you are!"
  "I think I found where we can end the expedition."
  # (Luna observa el lugar.)
  "I want the four of us to be there."
  "Come over when you're done looking."
  "I still have one part left."

npc E "Estrella" #33CCFF:
  "Ah."
  "You came out over here."
  "I wanted to know if it came back around."
  # (Pausa.)
  "What was in there?"
  # (El cubo negro no responde.)
  "..."
  "All right."
  "Now I know which way you come out."
