{
  "name": "EclipScript",
  "scopeName": "source.eclipscript",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#option"
    },
    {
      "include": "#narration"
    },
    {
      "include": "#dialogue"
    },
    {
      "include": "#flow_scene"
    },
    {
      "include": "#flow_word"
    },
    {
      "include": "#command"
    },
    {
      "include": "#string"
    },
    {
      "include": "#color"
    },
    {
      "include": "#param"
    },
    {
      "include": "#number"
    }
  ],
  "repository": {
    "comment": {
      "match": "(^|[ \\t])(#.*)$",
      "captures": {
        "2": {
          "name": "comment.line.number-sign.eclipscript"
        }
      }
    },
    "option": {
      "begin": "^(?=\\s*\"[^\"]*\"\\s*->)\\s*(\")",
      "beginCaptures": {
        "1": {
          "name": "string.quoted.double.eclipscript"
        }
      },
      "end": "(\")\\s*->\\s*(\\S+)",
      "endCaptures": {
        "1": {
          "name": "string.quoted.double.eclipscript"
        },
        "2": {
          "name": "entity.name.function.escena.eclipscript"
        }
      },
      "contentName": "string.quoted.double.eclipscript",
      "patterns": []
    },
    "narration": {
      "begin": "^(?=\\s*\")\\s*(\")",
      "beginCaptures": {
        "1": {
          "name": "string.quoted.double.texto.eclipscript"
        }
      },
      "end": "\\\"|$",
      "endCaptures": {
        "0": {
          "name": "string.quoted.double.texto.eclipscript"
        }
      },
      "contentName": "string.quoted.double.texto.eclipscript",
      "patterns": [
        {
          "include": "#etiqueta"
        }
      ]
    },
    "dialogue": {
      "begin": "^\\s*([A-Za-z_][\\w]*)(?:\\s+([A-Za-z_][\\w]*))?\\s*:\\s*(\")",
      "beginCaptures": {
        "1": {
          "name": "entity.name.type.quien.eclipscript"
        },
        "2": {
          "name": "entity.name.type.quien.eclipscript"
        },
        "3": {
          "name": "string.quoted.double.texto.eclipscript"
        }
      },
      "end": "\\\"|$",
      "endCaptures": {
        "0": {
          "name": "string.quoted.double.texto.eclipscript"
        }
      },
      "contentName": "string.quoted.double.texto.eclipscript",
      "patterns": [
        {
          "include": "#etiqueta"
        }
      ]
    },
    "etiqueta": {
      "match": "\\{[^{}\\n]*\\}",
      "name": "constant.character.escape.etiqueta.eclipscript"
    },
    "flow_scene": {
      "match": "^\\s*(escena|scene|ir_a|goto)\\b\\s+(\\S+)",
      "captures": {
        "1": {
          "name": "keyword.control.flujo.eclipscript"
        },
        "2": {
          "name": "entity.name.function.escena.eclipscript"
        }
      }
    },
    "flow_word": {
      "match": "^\\s*(fin_si|end_if|elegir|choose|sino|else|si|if|fin|end)\\b",
      "captures": {
        "1": {
          "name": "keyword.control.flujo.eclipscript"
        }
      }
    },
    "command": {
      "match": "^\\s*([A-Za-z_][\\w]*)",
      "captures": {
        "1": {
          "name": "keyword.other.comando.eclipscript"
        }
      }
    },
    "string": {
      "match": "\"[^\"\\n]*\"",
      "name": "string.quoted.double.eclipscript"
    },
    "color": {
      "match": "#[0-9A-Fa-f]+(?![A-Za-z0-9_])",
      "name": "variable.other.constant.color.eclipscript"
    },
    "param": {
      "match": "(?<![A-Za-z0-9_])([A-Za-z_][\\w]*)(?==)",
      "captures": {
        "1": {
          "name": "entity.other.attribute-name.parametro.eclipscript"
        }
      }
    },
    "number": {
      "match": "(?<![A-Za-z0-9_])-?\\d+(?:\\.\\d+)?",
      "name": "constant.numeric.eclipscript"
    }
  }
}
